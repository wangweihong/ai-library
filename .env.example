# Optional advanced overrides. Normal use only needs: make image && make run
# Copy to .env only when overriding a default; it is not required for startup.
# Existing database (mount its entire directory):
# PROMPT_DATA_DIR=/absolute/path/to/database-directory
# AI_LIBRARY_DB_NAME=prompts.sqlite3
# AI_LIBRARY_PORT=8765
# AI_LIBRARY_NETWORK=ai-library
# Only for bind mounts whose owner differs from the image's default 1000:1000:
# AI_LIBRARY_UID=1000
# AI_LIBRARY_GID=1000
